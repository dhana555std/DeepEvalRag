{#-
  report.html.j2 - structure of the evaluation report (styling lives in report.css).

  Context variables
    report      RunReport (ragqa.models): title, mode, runs, multi, passed, judges, ...
    summary     Summary (ragqa.reporting.summary): counters, root-cause list, threshold breaches
    brand_css   file name of the optional branding stylesheet, or None
    logo        file name of the optional logo, or None
    favicon     file name of the favicon copied next to the report (bundled default or configured)
    cases, page_size, pager_pages, cases_order   case list and client-side pagination settings
  Filters (registered by html_reporter.py): fmt(unit), status_class, status_label, short_error
  Sections: header -> key figures -> what needs attention -> results by layer -> case details
  (all cases are in the page; report.js shows page_size at a time with a pager)
  This is the report of ONE evaluation (single or multi run); it has no history/trend views.
  Override this template by placing a file of the same name in `template_dir` (config/reporting.yaml).
-#}
{% from "_case.html.j2" import render_case %}
{% from "_charts.html.j2" import bullet_row, range_row, donut_card, hist_card %}
{% set run0 = report.runs[0] %}
{% macro agg_badge(a) -%}
  {%- if a.errors and not a.n -%}<span class="badge err" title="Every case errored, so no score exists">NOT SCORED</span>
  {%- elif a.n == 0 -%}<span class="badge info">N/A</span>
  {%- else -%}<span class="badge {{ a.passed|status_class }}">{{ a.passed|status_label }}</span>{%- endif -%}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en" data-theme="{{ theme }}" data-default-theme="{{ theme }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }}</title>
  <meta name="color-scheme" content="light dark">
  <script>/* apply the saved theme before first paint (no flash); report.js owns the switcher */
    (function () { var d = document.documentElement; d.classList.remove('no-js');
      try { var t = localStorage.getItem('ragqa-theme'); if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t); } catch (e) {} })();
  </script>
  <link rel="icon" href="{{ favicon }}">
  <link rel="stylesheet" href="report.css">
  {% if brand_css %}<link rel="stylesheet" href="{{ brand_css }}">{% endif %}
  <script src="report.js" defer></script>
</head>
<body>
<div class="page-header-wrap">
<header class="page-header">
  {% if logo %}<img class="logo" src="{{ logo }}" alt="logo">{% endif %}
  <div class="titles">
    <h1>{{ report.title }}</h1>
    <div class="meta">
      <span class="meta-chip">{{ report.mode|capitalize }} run</span>
      <span class="meta-chip">{{ report.dataset_size }} cases</span>
      <span class="meta-chip">judge {{ report.judges|join(", ") }}</span>
      <span class="meta-chip">DeepEval {{ report.deepeval_version }}</span>
      {% if report.git_sha %}<span class="meta-chip">commit {{ report.git_sha }}</span>{% endif %}
      <span class="meta-chip">{{ report.created_at.strftime("%Y-%m-%d %H:%M UTC") }}</span>
    </div>
  </div>
  <div class="head-side">
    <div class="theme-switch" role="group" aria-label="Colour theme">
      <button type="button" data-theme-set="light" aria-pressed="{{ 'true' if theme == 'light' else 'false' }}" title="Light theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Light</button>
      <button type="button" data-theme-set="dark" aria-pressed="{{ 'true' if theme == 'dark' else 'false' }}" title="Dark theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>Dark</button>
    </div>
    <span class="verdict {{ summary.status }}">{{ {"pass": "PASSED", "fail": "FAILED", "incomplete": "INCOMPLETE"}[summary.status] }}</span>
  </div>
</header>
</div>

<main>
  <nav class="tabs" role="tablist" aria-label="Report sections">
    <button type="button" role="tab" id="tab-overview" data-tab="overview" aria-controls="panel-overview" aria-selected="true">Overview</button>
    <button type="button" role="tab" id="tab-layers" data-tab="layers" aria-controls="panel-layers" aria-selected="false" tabindex="-1">{{ "Results by Layer" if report.mode == "single" else "Multi-Run Statistics" }}</button>
    <button type="button" role="tab" id="tab-cases" data-tab="cases" aria-controls="panel-cases" aria-selected="false" tabindex="-1">Case Details</button>
  </nav>
  <div class="tab-panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" data-panel="overview">
  <section class="kpis" aria-label="Key figures">
    {% set pct = (summary.metrics_passed * 100 / summary.metrics_total)|round|int if summary.metrics_total else 0 %}
    <div class="kpi ring {{ 'good' if pct == 100 }}">
      <div class="ring-chart {{ 'bad' if pct < 60 else ('warn' if pct < 90) }}" style="--pct: {{ pct }}" role="img" aria-label="{{ pct }}% of metrics passed"><span>{{ pct }}%</span></div>
      <div><span class="kpi-value">{{ summary.metrics_passed }}<small>/{{ summary.metrics_total }}</small></span><span class="kpi-label">Metrics passed</span></div>
    </div>
    <div class="kpi {{ 'bad' if summary.metrics_failed }}"><span class="kpi-value">{{ summary.metrics_failed }}</span><span class="kpi-label">Below threshold</span></div>
    <div class="kpi {{ 'bad' if summary.metrics_errored }}"><span class="kpi-value">{{ summary.metrics_errored }}</span><span class="kpi-label">Could not be scored</span></div>
    <div class="kpi {{ 'bad' if summary.cases_failed }}"><span class="kpi-value">{{ summary.cases_failed }}<small>/{{ summary.cases_total }}</small></span><span class="kpi-label">Cases with a problem</span></div>
    <div class="kpi"><span class="kpi-value">{{ summary.metrics_info }}</span><span class="kpi-label">Informational</span></div>
  </section>

  {% if summary.has_issues %}
  {% macro attn_cause(c) %}
    <article class="attn warn">
      <div class="sev"></div>
      <div>
        <strong>{{ c.title }}</strong>
        {% if c.detail %}<code class="cause-detail">{{ c.detail }}</code>{% endif %}
        <small>Affected {{ c.cases }} of {{ summary.cases_total }} case{{ "s" if summary.cases_total != 1 }}{% if c.metrics %} &middot; {{ c.metrics|length }} metric{{ "s" if c.metrics|length != 1 }} not scored{% endif %}</small>
        <small><strong>Likely fix:</strong> {{ c.hint }}</small>
        {% if c.metrics %}<details><summary>Metrics not scored</summary><p class="chips">{% for k in c.metrics %}<span class="chip">{{ k }}</span>{% endfor %}</p></details>{% endif %}
      </div>
    </article>
  {% endmacro %}
  {% macro attn_breach(b) %}
    <article class="attn fail">
      <div class="sev"></div>
      <div>
        <strong>{{ b.key }}</strong>{% if report.mode == "multi" %} <span class="muted">({{ b.judge }})</span>{% endif %}
        <small>{{ b.value }} vs {{ b.threshold }} &middot; short by {{ b.gap }}</small>
      </div>
    </article>
  {% endmacro %}
  {# run problems first, then missed targets worst-first; the first 3 are always visible, the rest expand #}
  {% set n_causes = summary.causes|length %}
  {% set total_issues = n_causes + summary.breaches|length %}
  <section class="issues">
    <h2>What needs attention <span class="muted">({{ total_issues }})</span></h2>
    <div class="attn-list">
    {% for c in summary.causes[:3] %}{{ attn_cause(c) }}{% endfor %}
    {% for b in summary.breaches[:[3 - n_causes, 0]|max] %}{{ attn_breach(b) }}{% endfor %}
    </div>
    {% if total_issues > 3 %}
    <details class="attn-more">
      <summary><span class="when-closed">Show {{ total_issues - 3 }} more</span><span class="when-open">Show fewer</span></summary>
      <div class="attn-list">
      {% for c in summary.causes[3:] %}{{ attn_cause(c) }}{% endfor %}
      {% for b in summary.breaches[[3 - n_causes, 0]|max:] %}{{ attn_breach(b) }}{% endfor %}
      </div>
    </details>
    {% endif %}
  </section>
  {% endif %}

  <section class="overview" aria-label="Overview charts">
    <h2>Overview</h2>
    <div class="chart-grid">
      {% set hm = layer_metric_matrix(run0.aggregates if report.mode == "single" else report.multi) %}
      <article class="chart-card heatmap-card">
        <h3>Health heatmap <span class="muted">(layer &times; metric, mean score)</span></h3>
        {% set d = donut([("Passed", summary.metrics_passed, "pass"), ("Below threshold", summary.metrics_failed, "fail"), ("Not scored", summary.metrics_errored, "warn"), ("Informational", summary.metrics_info, "info")]) %}
        <div class="hm-layout">
        <div class="donut-wrap hm-donut">
          <div class="donut" style="background: {{ d.style }}" role="img" aria-label="Metric outcomes"><div class="donut-hole"><strong>{{ summary.metrics_total }}</strong><small>metrics</small></div></div>
          <ul class="legend">{% for i in d['items'] %}<li><i class="dot {{ i.tone }}"></i>{{ i.label }} <strong>{{ i.value|int }}</strong></li>{% endfor %}</ul>
        </div>
        <div class="hm-main">
        <div class="heatmap" role="table" aria-label="Metric health by layer">
          {% for r in hm.rows %}
          <div class="hm-row"><span class="hm-layer">{{ r.title }}</span>
            <div class="hm-cells">{% for c in r.cells if c %}<div class="hm-cell {{ c.tone }}" title="{{ c.key }}: {{ {'pass': 'passed', 'fail': 'below threshold', 'err': 'not scored', 'info': 'informational'}[c.tone] }}"><small>{{ c.key.split(".")[-1]|replace("_", " ") }}</small><b>{{ "–" if c.mean is none else c.mean|fmt(c.unit) }}</b></div>{% endfor %}</div></div>
          {% endfor %}
        </div>
        </div></div>
      </article>
      {{ donut_card("Case outcomes", [("No problem", summary.cases_total - summary.cases_failed, "pass"), ("With a problem", summary.cases_failed, "fail")], summary.cases_total, "cases") }}
      {% set lat = stage_latency(run0.cases) %}
      {% if lat %}
      <article class="chart-card">
        <h3>Latency by stage <span class="muted">(mean and p95)</span></h3>
        {% for r in lat %}
        <div class="lat-stage" role="img" aria-label="{{ r.stage }}: mean {{ r.mean|fmt('ms') }}, p95 {{ r.p95|fmt('ms') }}">
          <div class="lat-top"><span class="brow-label">{{ r.stage }}</span><span class="bval">{{ r.mean|fmt('ms') }}<small class="muted"> · p95 {{ r.p95|fmt('ms') }}</small></span></div>
          <div class="spark" title="latency per case, scaled to this stage's slowest case">{% for h in r.spark %}<i style="height: {{ h }}%"></i>{% endfor %}</div>
        </div>
        {% endfor %}
      </article>
      {% endif %}
    </div>
  </section>
  </div>

  <div class="tab-panel" role="tabpanel" id="panel-layers" aria-labelledby="tab-layers" data-panel="layers" hidden>
{% if report.mode == "single" %}
  {% set run = report.runs[0] %}
  <section id="results-by-layer">
    <h2>Results by layer</h2>
    <p class="muted legend-note">Each check below says what was measured, how far it is from its target, and what usually fixes it. Technical numbers are under &ldquo;Technical details&rdquo;.</p>
    {% set scores = metric_scores(run) %}
    {% for layer, title, aggs in group_by_layer(run.aggregates) %}
    {% set st = layer_story(aggs, run.cases) %}
    <div class="layer-head {{ st.status }}">
      <h3>{{ title }}</h3>
      <span class="layer-chip {{ st.status }}">{{ st.label }}</span>
      <span class="layer-sentence">{{ st.sentence }}</span>
    </div>
    <div class="metric-cards">
      {% for c in st.cards %}
      <article class="mcard {{ c.tone }}">
        <header>
          <div class="mtitle"><strong>{{ c.label }}</strong><small>{{ c.title }}</small></div>
          {% if c.tone == "err" %}<span class="badge err">NOT SCORED</span>{% elif c.tone == "info" %}<span class="badge info">INFO</span>{% endif %}
        </header>
        {% if c.bullet %}
        <div class="btrack" role="img" aria-label="{{ c.value }}, target {{ c.target }}"><i class="bfill {{ c.tone if c.tone in ('pass','fail') else 'info' }}" style="width: {{ c.bullet.fill }}%"></i>{% if c.bullet.tick is not none %}<b class="btick" style="left: {{ c.bullet.tick }}%" title="target {{ c.target }}"></b>{% endif %}</div>
        {% endif %}
        <p class="mtext">{{ c.text }}</p>
        {% if c.tone == "fail" %}
        <dl class="mdetail">
          <dt>Where</dt><dd>Below target in <strong>{{ c.failed_cases }} of {{ c.n }}</strong> cases{% if c.worst %}. Worst: {% for w in c.worst %}<a href="#case-{{ w }}">{{ w }}</a>{{ ", " if not loop.last }}{% endfor %}{% endif %}</dd>
          {% if c.fix %}<dt>Likely fix</dt><dd>{{ c.fix }}</dd>{% endif %}
        </dl>
        {% endif %}
      </article>
      {% endfor %}
    </div>
    <details class="tech">
      <summary>Technical details for {{ title }}</summary>
      <div class="layer-charts">
        <article class="chart-card">
          <h4>Distribution across cases</h4>
          <div class="hist-grid">
            {% for a in aggs %}{% if scores.get(a.key) %}{{ hist_card(a.name, scores[a.key], a.threshold, a.direction, a.unit) }}{% endif %}{% endfor %}
          </div>
        </article>
      </div>
      <table class="grid results">
        <colgroup><col class="c-name"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-scored"><col class="c-status"></colgroup>
        <thead><tr><th>Metric</th><th class="num">Value</th><th class="num">Threshold</th><th class="num">Mean</th><th class="num">Min</th><th class="num">Max</th><th class="num">Pass rate</th><th class="num">Scored</th><th class="center">Status</th></tr></thead>
        <tbody>
        {% for a in aggs %}
          <tr>
            <td>{{ a.name }}{% if a.aggregate_used == "p95" %} <span class="muted">(p95)</span>{% endif %}</td>
            <td class="num">{{ a.value|fmt(a.unit) }}</td>
            <td class="num">{{ ("≥ " if a.direction == "min" else "≤ ") ~ (a.threshold|fmt(a.unit)) if a.threshold is not none else "–" }}</td>
            <td class="num">{{ a.mean|fmt(a.unit) }}</td>
            <td class="num">{{ a.min|fmt(a.unit) }}</td>
            <td class="num">{{ a.max|fmt(a.unit) }}</td>
            <td class="num">{% if a.case_pass_rate is not none %}{{ "%.0f%%"|format(a.case_pass_rate * 100) }}<span class="bar {{ 'bad' if a.case_pass_rate < 0.6 else ('warn' if a.case_pass_rate < 0.9) }}"><i style="width: {{ (a.case_pass_rate * 100)|round|int }}%"></i></span>{% else %}–{% endif %}</td>
            <td class="num">{{ a.n }}{% if a.errors %}<span class="badge err" title="{{ a.errors }} case(s) could not be scored and are excluded from the value">+{{ a.errors }} not scored</span>{% endif %}</td>
            <td class="center">{{ agg_badge(a) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </details>
    {% endfor %}
  </section>
{% else %}
  <section>
    <h2>Multi-run statistics</h2>
    <p class="muted">Each value is the per-run aggregate; the gate compares the mean across runs.
      Standard deviation shows run-to-run (judge) variance.</p>
    {% for layer, title, rows in group_by_layer(report.multi) %}
    <h3>{{ title }}</h3>
    <article class="chart-card layer-chart-single">
      <h4>Spread across runs <span class="muted">(bar = min–max, dot = mean, tick = threshold)</span></h4>
      {% for m in rows %}{{ range_row(m) }}{% endfor %}
    </article>
    <table class="grid results multi">
      <colgroup><col class="c-name"><col class="c-judge"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-num"><col class="c-status"></colgroup>
      <thead><tr><th>Metric</th><th>Judge</th><th class="num">Runs</th><th class="num">Mean</th><th class="num">Std dev</th><th class="num">Min</th><th class="num">Max</th><th class="num">Threshold</th><th class="center">Status</th></tr></thead>
      <tbody>
      {% for m in rows %}
        <tr>
          <td>{{ m.name }}</td><td>{{ m.judge }}</td><td class="num">{{ m.runs }}</td>
          <td class="num">{{ m.mean|fmt(m.unit) }}</td><td class="num">{{ m.std|fmt(m.unit) }}</td>
          <td class="num">{{ m.min|fmt(m.unit) }}</td><td class="num">{{ m.max|fmt(m.unit) }}</td>
          <td class="num">{{ ("≥ " if m.direction == "min" else "≤ ") ~ (m.threshold|fmt(m.unit)) if m.threshold is not none else "–" }}</td>
          <td class="center">{% if m.mean is none %}<span class="badge err">NOT SCORED</span>{% else %}<span class="badge {{ m.passed|status_class }}">{{ m.passed|status_label }}</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endfor %}
  </section>
{% endif %}
  </div>

  <div class="tab-panel" role="tabpanel" id="panel-cases" aria-labelledby="tab-cases" data-panel="cases" hidden>
  <section id="cases">
    <h2>Case details{% if report.mode == "multi" %} <span class="muted">(first run of the first judge)</span>{% endif %}</h2>
    {# Every case is in the page; report.js shows `page_size` at a time and fills the pager placeholders. #}
    <div class="case-filter" role="group" aria-label="Filter cases">
      <button type="button" data-filter="all" aria-pressed="true">All <b>{{ cases|length }}</b></button>
      <button type="button" data-filter="fail" aria-pressed="false">Below threshold <b>{{ case_counts.fail }}</b></button>
      <button type="button" data-filter="err" aria-pressed="false">Not scored <b>{{ case_counts.err }}</b></button>
      <button type="button" data-filter="pass" aria-pressed="false">Passed <b>{{ case_counts.pass }}</b></button>
      {% if categories|length > 1 %}<select data-category aria-label="Category"><option value="">All categories</option>{% for k in categories %}<option>{{ k }}</option>{% endfor %}</select>{% endif %}
      <input type="search" data-search placeholder="Search question or id" aria-label="Search cases">
    </div>
    <p class="muted page-info" data-page-info data-suffix="{{ '· problem cases first' if cases_order == 'failed_first' else '' }}"></p>
    <nav class="pager" data-pager aria-label="Case pages" hidden></nav>
    <div class="case-head" aria-hidden="true"><span>Case</span><span>Problems</span><span>Question</span><span>Worst metric</span><span>Status</span></div>
    <div id="case-list" data-page-size="{{ page_size }}" data-pager-pages="{{ pager_pages }}">
      {% for c in cases %}{{ render_case(c) }}{% endfor %}
    </div>
    <nav class="pager" data-pager aria-label="Case pages" hidden></nav>
  </section>
  </div>
</main>
<footer>Generated by ragqa {{ report.created_at.strftime("%Y-%m-%d %H:%M UTC") }}</footer>
</body>
</html>
