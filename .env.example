# =============================================================================
#  ragqa - environment configuration
#  Copy to .env (never commit .env). In CI, set these as secrets / variables.
#  Lines starting with "#" are optional: uncomment and fill in to use them.
# =============================================================================


# =============================================================================
#  1. RAG APPLICATION UNDER TEST
# =============================================================================
# Endpoints (payload shapes live in config/rag_api.yaml)
RETRIEVAL_API_URL=http://localhost:8080/v1/retrieve
GENERATION_API_URL=http://localhost:8080/v1/answer

# Authentication - none is required for now. When it is added, set the type and token:
#   bearer -> "Authorization: Bearer <token>"      header -> "<header from rag_api.yaml>: <token>"
# RETRIEVAL_AUTH_TYPE=bearer            # none | bearer | header
# RETRIEVAL_API_TOKEN=
# GENERATION_AUTH_TYPE=bearer
# GENERATION_API_TOKEN=

# Request behaviour
# RAG_TIMEOUT_S=30

# Cost fallback (when the API reports tokens but not cost)
# PRICE_PER_1K_PROMPT=0.0
# PRICE_PER_1K_COMPLETION=0.0


# =============================================================================
#  2. JUDGE SELECTION   <-- the switch between an LLM judge and Jev
# =============================================================================
# JUDGE_PROVIDER picks who scores the LLM-judged metrics:
#   groq (default) | anthropic | openai | google | bedrock    -> an LLM judge
#   jev                                                       -> Jev (TypeSafe), no LLM
# Per run, the CLI overrides it:   ragqa run --judge jev      (compare: --judges groq,jev)
JUDGE_PROVIDER=groq


# =============================================================================
#  3. LLM JUDGE CREDENTIALS (only the provider selected above is needed)
# =============================================================================
# --- Groq (default) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Google ---
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-pro

# --- Amazon Bedrock (AWS credential chain, no single API key) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=                          # alternative: SSO / named profile
# AWS_BEARER_TOKEN_BEDROCK=             # alternative: Bedrock API key
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0


# =============================================================================
#  4. JEV JUDGE (TypeSafe System One) - used when JUDGE_PROVIDER=jev
# =============================================================================
# JEV_API_KEY=                          # required when Jev is selected
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest


# =============================================================================
#  5. HARNESS
# =============================================================================
# RAGQA_CONFIG_DIR=config
# RAGQA_DATASET=datasets/golden.jsonl
# RAGQA_RUNS=1                          # >1 makes the pytest suite run in multi-run mode
# RAGQA_LIMIT=5                         # evaluate only the first N cases
# RAGQA_ONLY=retriever.*                # comma separated metric patterns
# RAGQA_CONCURRENCY=4

# Keep DeepEval offline/private (no telemetry, no Confident AI upload)
DEEPEVAL_TELEMETRY_OPT_OUT=YES
